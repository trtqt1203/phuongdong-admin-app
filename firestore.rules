rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminProfile() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && adminProfile().data.role in ['owner', 'admin', 'staff']
        && adminProfile().data.disabled != true;
    }

    function isOwner() {
      return isAdmin() && adminProfile().data.role == 'owner';
    }

    function validPublicBooking(id) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'type', 'name', 'phone', 'email', 'product', 'budget', 'note',
          'date', 'time', 'status', 'payMethod', 'quote', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'type', 'name', 'phone', 'email', 'product', 'budget', 'note',
          'date', 'time', 'status', 'payMethod', 'quote', 'adminNote', 'createdAt',
          'updatedAt', 'statusHistory'
        ])
        && data.id == id
        && data.id.matches('PD-[A-Z0-9]{6}')
        && data.type in ['tuvan', 'domay']
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 9 && data.phone.size() <= 20
        && data.email is string && data.email.size() <= 160
        && data.product is string && data.product.size() <= 160
        && data.budget is string && data.budget.size() <= 100
        && data.note is string && data.note.size() <= 1000
        && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.time is string && data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && data.status == 'pending'
        && data.payMethod is string && data.payMethod.size() <= 60
        && data.quote == null
        && data.adminNote == ''
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (!('statusHistory' in data) || data.statusHistory.size() == 0);
    }

    match /bookings/{bookingId} {
      allow create: if isAdmin() || validPublicBooking(bookingId);
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    match /admin_tokens/{tokenId} {
      allow create, update: if isAdmin() && request.resource.data.uid == request.auth.uid;
      allow read: if isOwner();
      allow delete: if isAdmin() && (resource.data.uid == request.auth.uid || isOwner());
    }

    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
